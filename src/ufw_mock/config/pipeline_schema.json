{
  "$defs": {
    "EdgeDirection": {
      "enum": [
        "INBOUND",
        "OUTBOUND"
      ],
      "title": "EdgeDirection",
      "type": "string"
    },
    "EdgeNode": {
      "description": "A contract boundary between source/target systems and the core platform.",
      "properties": {
        "name": {
          "description": "Logical name of the edge node.",
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/EdgeDirection",
          "description": "Whether this edge receives or publishes data."
        },
        "protocol": {
          "$ref": "#/$defs/EdgeProtocol",
          "default": "file"
        },
        "owner": {
          "default": "central-data-platform",
          "title": "Owner",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "required": [
        "name",
        "direction"
      ],
      "title": "EdgeNode",
      "type": "object"
    },
    "EdgeProtocol": {
      "enum": [
        "file",
        "kafka",
        "rest",
        "jdbc"
      ],
      "title": "EdgeProtocol",
      "type": "string"
    },
    "SchemaRef": {
      "description": "Reference to a schema definition, either inline or external.",
      "properties": {
        "catalog": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog"
        },
        "database": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "inline": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inline"
        }
      },
      "title": "SchemaRef",
      "type": "object"
    },
    "Source": {
      "description": "Input location and format for a task.",
      "properties": {
        "edge_node": {
          "description": "Logical name of the edge node to read from.",
          "title": "Edge Node",
          "type": "string"
        },
        "path": {
          "description": "Path or identifier within the edge node.",
          "title": "Path",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/StorageFormat",
          "default": "parquet"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "required": [
        "edge_node",
        "path"
      ],
      "title": "Source",
      "type": "object"
    },
    "StorageFormat": {
      "enum": [
        "parquet",
        "iceberg",
        "delta",
        "json",
        "csv"
      ],
      "title": "StorageFormat",
      "type": "string"
    },
    "Target": {
      "description": "Output location and format for a task.",
      "properties": {
        "edge_node": {
          "description": "Logical name of the edge node to write to.",
          "title": "Edge Node",
          "type": "string"
        },
        "path": {
          "description": "Path or identifier within the edge node.",
          "title": "Path",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/StorageFormat",
          "default": "parquet"
        },
        "mode": {
          "$ref": "#/$defs/WriteMode",
          "default": "overwrite"
        },
        "partition_by": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition By"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "required": [
        "edge_node",
        "path"
      ],
      "title": "Target",
      "type": "object"
    },
    "Task": {
      "description": "A single stage inside a pipeline.",
      "properties": {
        "id": {
          "description": "Unique task identifier within the pipeline.",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TaskType",
          "description": "Task category: INGEST, TRANSFORM, VALIDATE, or PUBLISH."
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "transformations": {
          "items": {
            "$ref": "#/$defs/Transformation"
          },
          "title": "Transformations",
          "type": "array"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "title": "Task",
      "type": "object"
    },
    "TaskType": {
      "enum": [
        "INGEST",
        "TRANSFORM",
        "VALIDATE",
        "PUBLISH"
      ],
      "title": "TaskType",
      "type": "string"
    },
    "Transformation": {
      "description": "A declarative transformation to be applied to a Spark DataFrame.",
      "properties": {
        "name": {
          "description": "Human-readable name for the transform step.",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "Transform key, e.g. 'select', 'filter', 'custom.segment_by_risk'.",
          "title": "Type",
          "type": "string"
        },
        "input_cols": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Cols"
        },
        "output_col": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Col"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Transformation",
      "type": "object"
    },
    "WriteMode": {
      "enum": [
        "overwrite",
        "append",
        "merge",
        "ignore",
        "error_if_exists"
      ],
      "title": "WriteMode",
      "type": "string"
    }
  },
  "description": "A declarative, JSON-driven workflow of tasks.",
  "properties": {
    "name": {
      "description": "Unique pipeline name.",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "owner": {
      "default": "central-data-platform",
      "title": "Owner",
      "type": "string"
    },
    "schedule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional cron expression.",
      "title": "Schedule"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "title": "Properties"
    },
    "edge_nodes": {
      "items": {
        "$ref": "#/$defs/EdgeNode"
      },
      "title": "Edge Nodes",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "name",
    "tasks"
  ],
  "title": "Pipeline",
  "type": "object"
}